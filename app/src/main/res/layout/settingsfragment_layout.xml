<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waver v1.5.3"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/maincontent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.06" />

    <TextView
        android:id="@+id/capture_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sample rate (capture): 48000, 4 B/sample"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@id/maincontent"
        app:layout_constraintTop_toTopOf="@+id/maincontent"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/playback_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sample rate (playback): 48000, 4 B/sample"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@id/capture_rate"
        app:layout_constraintTop_toBottomOf="@+id/capture_rate"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/volume_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="Volume:"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@id/playback_rate"
        app:layout_constraintTop_toBottomOf="@+id/playback_rate"
        app:layout_verticalBias=".46" />

    <SeekBar
        android:id="@+id/volume"
        android:layout_width="304dp"
        android:layout_height="28dp"
        android:layout_marginStart="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/volume_label"
        app:layout_constraintTop_toTopOf="@id/volume_label" />

    <TextView
        android:id="@+id/volume_tooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Normal Volume"
        app:layout_constraintStart_toStartOf="@id/volume"
        app:layout_constraintBottom_toTopOf="@id/volume"/>

</androidx.constraintlayout.widget.ConstraintLayout>