<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/VAnchor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"/>

    <Button
        android:id="@+id/sendtab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Send"
        app:layout_constraintEnd_toStartOf="@+id/VAnchor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/fileholder"
        tools:layout_editor_absoluteY="57dp" />

    <Button
        android:id="@+id/recievetab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Recieve"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/VAnchor"
        app:layout_constraintBottom_toBottomOf="@id/fileholder"
        tools:layout_editor_absoluteY="57dp" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fileholder"
        android:layout_width="396dp"
        android:layout_height="783dp"
        tools:layout_editor_absoluteX="6dp"
        tools:layout_editor_absoluteY="105dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>